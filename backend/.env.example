NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_ACCESS_SECRET=change-me-min-32-characters-long!!
JWT_REFRESH_SECRET=change-me-min-32-characters-long!!
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=lossdefenderpro-media
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
# --- JWT TTLs ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Marketplace webhook secrets (per-provider) ---
WEBHOOK_SECRET=change-me-generic-fallback
WEBHOOK_SECRET_AMAZON=
WEBHOOK_SECRET_FLIPKART=
WEBHOOK_SECRET_MEESHO=
WEBHOOK_SECRET_SHOPIFY=
WEBHOOK_SECRET_WOOCOMMERCE=

# --- Amazon SP-API (marketplace sync, not yet wired) ---
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=

# --- Firebase / FCM (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Security ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Storage ---
B2_SIGNED_URL_TTL=900

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=info
