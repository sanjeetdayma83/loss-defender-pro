// Loss Defender Pro — Prisma Schema (Auth + Tenant + Orders foundation)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyPlan {
  free
  starter
  professional
  business
  enterprise
}

enum CompanyStatus {
  active
  suspended
  deleted
}

enum WarehouseStatus {
  active
  inactive
  maintenance
}

enum StationStatus {
  online
  offline
  maintenance
  inactive
}

enum UserStatus {
  pending
  active
  suspended
  deleted
}

enum Role {
  super_admin
  owner
  manager
  supervisor
  packing_operator
  qc_operator
  claims_executive
  marketplace_manager
  viewer
  auditor
}

enum Marketplace {
  amazon
  flipkart
  meesho
  shopify
  woocommerce
  manual
}

enum OrderStatus {
  synced
  queued
  packing
  recording
  scanned
  evidence_ready
  dispatched
  shipped
  claimed
  returned
  closed
}

enum OrderItemStatus {
  pending
  matched
  partial
  mismatch
}

model Company {
  id           String        @id @default(uuid())
  companyName  String
  gst          String?
  pan          String?
  address      Json?
  phone        String
  email        String        @unique
  website      String?
  timezone     String        @default("Asia/Kolkata")
  currency     String        @default("INR")
  storageUsed  BigInt        @default(0)
  storageQuota BigInt        @default(10737418240)
  plan         CompanyPlan   @default(free)
  logo         String?
  status       CompanyStatus @default(active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users      User[]
  warehouses Warehouse[]
  auditLogs  AuditLog[]
  orders     Order[]
  recordings Recording[]
  evidence   Evidence[]

  @@index([status])
}

model Warehouse {
  id        String          @id @default(uuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   Json
  city      String
  state     String
  country   String          @default("India")
  timezone  String?
  status    WarehouseStatus @default(active)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  stations   Station[]
  users      User[]
  orders     Order[]
  recordings Recording[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model Station {
  id              String        @id @default(uuid())
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stationName     String
  stationId       String
  camera          Json?
  scanner         Json?
  printer         Json?
  status          StationStatus @default(offline)
  lastHeartbeatAt DateTime?
  createdAt       DateTime      @default(now())

  orders     Order[]
  recordings Recording[]

  @@unique([warehouseId, stationId])
}

model User {
  id               String     @id @default(uuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId       String?
  name             String
  phone            String
  email            String     @unique
  passwordHash     String
  role             Role       @default(packing_operator)
  warehouseId      String?
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  status           UserStatus @default(pending)
  profilePhoto     String?
  joiningDate      DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  auditLogs          AuditLog[]
  assignedOrders     Order[]                  @relation("OrderOperator")
  recordings         Recording[]              @relation("RecordingOperator")

  @@index([companyId, status])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  userAgent        String?
  ipAddress        String?
  revoked          Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model InviteToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorId, action])
}

model Order {
  id                 String      @id @default(uuid())
  companyId          String
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouseId        String?
  warehouse          Warehouse?  @relation(fields: [warehouseId], references: [id])
  marketplace        Marketplace @default(manual)
  marketplaceOrderId String?
  status             OrderStatus @default(synced)
  assignedOperatorId String?
  assignedOperator   User?       @relation("OrderOperator", fields: [assignedOperatorId], references: [id])
  stationId          String?
  station            Station?    @relation(fields: [stationId], references: [id])
  customerName       String?
  customerPhone      String?
  shippingAddress    Json?
  awb                String?
  courier            String?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  metadata           Json?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  items      OrderItem[]
  recordings Recording[]
  evidence   Evidence[]

  @@index([companyId, status])
  @@index([companyId, warehouseId])
  @@index([assignedOperatorId])
  @@index([marketplace, marketplaceOrderId])
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku        String
  name       String
  qty        Int
  scannedQty Int             @default(0)
  status     OrderItemStatus @default(pending)
  barcode    String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([orderId])
  @@index([sku])
}

// ===== Recording & Evidence (P1) =====
enum RecordingStatus {
  started
  paused
  completed
  processing
  processed
  failed
}

enum EvidenceStatus {
  pending
  ready
  archived
  failed
}

model Recording {
  id           String          @id @default(uuid())
  companyId    String
  orderId      String
  warehouseId  String
  stationId    String?
  operatorId   String
  status       RecordingStatus @default(started)
  startedAt    DateTime        @default(now())
  pausedAt     DateTime?
  completedAt  DateTime?
  durationSec  Int?
  segmentCount Int             @default(0)
  totalBytes   BigInt          @default(0)
  b2Prefix     String?
  checksum     String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  order     Order              @relation(fields: [orderId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  station   Station?           @relation(fields: [stationId], references: [id])
  operator  User               @relation("RecordingOperator", fields: [operatorId], references: [id])
  segments  RecordingSegment[]
  evidence  Evidence?

  @@index([companyId, status])
  @@index([orderId])
  @@index([operatorId])
  @@map("recordings")
}

model RecordingSegment {
  id          String   @id @default(uuid())
  recordingId String
  companyId   String
  sequence    Int
  b2Key       String
  sizeBytes   BigInt
  durationSec Int?
  checksum    String?
  uploadedAt  DateTime @default(now())

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, sequence])
  @@index([companyId])
  @@map("recording_segments")
}

model Evidence {
  id             String         @id @default(uuid())
  companyId      String
  recordingId    String         @unique
  orderId        String
  status         EvidenceStatus @default(pending)
  frameCount     Int            @default(0)
  thumbnailKey   String?
  packKey        String?
  checksum       String?
  overlays       Json?
  retentionUntil DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  recording Recording       @relation(fields: [recordingId], references: [id])
  order     Order           @relation(fields: [orderId], references: [id])
  frames    EvidenceFrame[]

  @@index([companyId, status])
  @@index([orderId])
  @@map("evidence")
}

model EvidenceFrame {
  id          String   @id @default(uuid())
  evidenceId  String
  companyId   String
  sequence    Int
  b2Key       String
  timestampMs Int?
  label       String?
  checksum    String?
  createdAt   DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, sequence])
  @@index([companyId])
  @@map("evidence_frames")
}

// ===== Claims & Returns =====
enum ClaimStatus {
  open
  investigating
  approved
  rejected
  escalated
  closed
}

enum ReturnStatus {
  requested
  received
  inspecting
  refunded
  restocked
  rejected
  closed
}

model Claim {
  id            String      @id @default(uuid())
  companyId     String
  orderId       String
  reason        String
  marketplace   String?
  description   String?
  status        ClaimStatus @default(open)
  evidenceIds   String[]    @default([])
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  closedAt      DateTime?

  company       Company     @relation(fields: [companyId], references: [id])
  order         Order       @relation(fields: [orderId], references: [id])

  @@index([companyId, status])
  @@index([orderId])
  @@map("claims")
}

model Return {
  id            String       @id @default(uuid())
  companyId     String
  orderId       String
  reason        String?
  status        ReturnStatus @default(requested)
  conditionNote String?
  decision      String?
  recordingId   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  closedAt      DateTime?

  company       Company      @relation(fields: [companyId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id])

  @@index([companyId, status])
  @@index([orderId])
  @@map("returns")
}
